[binaries]
c = 'clang'

[host_machine]
system = 'unknown'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
c_args = [
  '--target=x86_64-unknown-elf',
  '--no-default-config',
  '-ffreestanding',
  '-fno-plt',
  '-fno-pie',
  '-fno-pic',
  '-static',
  '-fno-common',
  '-nostdlib',
  '-nostartfiles',
  '-nodefaultlibs',
  '-mcmodel=kernel',
  '-mno-red-zone'
  ]
needs_exe_wrapper = true
skip_sanity_check = true
